# Developed on Windows: normalize everything, but start.sh must land in the
# Docker image with LF endings or sh refuses to run it.
* text=auto
*.sh text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# The demo sample is compared against a golden expectation and must hash the
# same in a Windows working tree as it does in the image.
api/app/demo/sample/files/** text eol=lf
