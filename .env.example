# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---

# development | production
ENVIRONMENT=development
# Matches the docker-compose defaults (user/password/db all "difflens"); psycopg3 driver
DATABASE_URL=postgresql+psycopg://difflens:difflens@localhost:55432/difflens
# Local Redis from docker-compose
REDIS_URL=redis://localhost:6379/0

# Reviews one account may start per window. Starting a review is the only
# call that spends GitHub quota, worker time, and AI tokens. 0 disables it.
REVIEW_RATE_LIMIT=20
REVIEW_RATE_LIMIT_WINDOW_S=3600

# --- Demo ---

# The public demo at /demo: one seeded pull request anyone can review with no
# account. Off by default, so a deployment opts in. When on, the API seeds the
# demo rows at boot (start.sh) and exposes read-only /demo/* routes; when off
# those routes answer 404 rather than 403, so there is no surface to probe.
DEMO_MODE=0
# Demo reruns one address may start per window. This is fair sharing, not the
# safety floor: the live-review index caps the demo at one job at a time in
# Postgres regardless. 0 disables it.
DEMO_RATE_LIMIT=5
DEMO_RATE_LIMIT_WINDOW_S=3600

# --- Contact ---

# Messages one address may send through /contact per window. 0 disables it.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_LIMIT_WINDOW_S=3600
# Optional forwarding of contact messages by email, via Resend (resend.com).
# With either value empty, messages still land in Postgres and nothing is
# lost; they are just not emailed on.
RESEND_API_KEY=
# The address forwarded contact messages are sent to
CONTACT_FORWARD_TO=

# --- Auth ---

# From your GitHub OAuth app (Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=your-github-oauth-client-id
# Client secret for the same OAuth app
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Signs session cookies. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me
# Encrypts stored GitHub tokens at rest. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me

# --- AI ---

# off | mock | gemini | anthropic | openai. "mock" runs the full AI pipeline with zero
# API calls and zero findings; "gemini" with a free AI Studio key is the
# zero-cost way to run real reviews; "off" is deterministic only.
# Signed-in users can also bring their own key in Settings, which wins over this.
AI_PROVIDER=mock
# Empty = the provider's default model
# (gemini-3.6-flash / claude-opus-5 / gpt-5.6-terra)
AI_MODEL=
# aistudio.google.com/apikey (free tier); only read when AI_PROVIDER=gemini
GEMINI_API_KEY=
# console.anthropic.com > API keys; only read when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# platform.openai.com > API keys; only read when AI_PROVIDER=openai
OPENAI_API_KEY=

# --- Frontend ---

# Where the Next.js rewrite proxy forwards /api/* requests
API_ORIGIN=http://localhost:8000
# Used by the API for OAuth redirects and cookie settings
FRONTEND_ORIGIN=http://localhost:3000
